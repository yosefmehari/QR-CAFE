generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── USERS (Admin & Kitchen staff) ──────────────────────────────────────────

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // stored as a bcrypt hash, never plain text
  name      String
  role      Role     @default(KITCHEN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  KITCHEN
  JUICE_MAKER
  WAITER
  DELIVERY
}

// ─── CATEGORIES (Burgers, Pizza, Drinks…) ───────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  emoji     String?
  sortOrder Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// ─── PRODUCTS (menu items) ──────────────────────────────────────────────────

model Product {
  id          String      @id @default(cuid())
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean     @default(true)
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// ─── TABLES (physical cafe tables with QR codes) ─────────────────────────────

model Table {
  id        String   @id @default(cuid())
  number    Int      @unique
  qrCode    String?
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── ORDERS ─────────────────────────────────────────────────────────────────

model Order {
  id                String        @id @default(cuid())
  table             Table?        @relation(fields: [tableId], references: [id])
  tableId           String?
  orderType         OrderType     @default(DINE_IN)
  customerName      String?
  customerPhone     String?
  deliveryAddress   String?
  deliveryNotes     String?
  acceptedBy        String?
  status            OrderStatus   @default(PENDING)
  paymentMethod     PaymentMethod @default(CARD)
  paymentStatus     PaymentStatus @default(PENDING)
  paymentReference  String?
  paymentScreenshot String?
  totalPrice        Decimal       @db.Decimal(10, 2)
  notes             String?
  items             OrderItem[]
  complaints        OrderComplaint[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

enum OrderType {
  DINE_IN
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  SERVED
  CANCELLED
}

enum PaymentMethod {
  CARD
  APPLE_PAY
  GOOGLE_PAY
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

// ─── CAFE SETTINGS (Admin configurable bank details & cafe info) ──────────────

model CafeSetting {
  id                String   @id @default("default")
  bankName          String   @default("Commercial Bank of Ethiopia (CBE)")
  bankAccountNumber String   @default("1000234567890")
  accountHolderName String   @default("Aroma & Fork Cafe LLC")
  telebirrNumber    String?  @default("0911000000")
  paymentInstructions String? @default("Transfer the total order amount and enter the transaction confirmation code / receipt number below.")
  updatedAt         DateTime @updatedAt
}

// ─── ORDER ITEMS ─────────────────────────────────────────────────────────────

model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  unitPrice Decimal @db.Decimal(10, 2)
  notes     String?
}

// ─── ORDER COMPLAINTS & QUALITY ISSUES ───────────────────────────────────────

model OrderComplaint {
  id            String   @id @default(cuid())
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  category      String   // FOOD_QUALITY, COLD_FOOD, WRONG_ITEM, MISSING_ITEM, DELAY, OTHER
  items         String?  // affected items description
  details       String   // customer complaint details
  desiredAction String?  // REMAKE, CALL_STAFF, REFUND, FEEDBACK
  status        String   @default("PENDING") // PENDING, REVIEWING, RESOLVED, DISMISSED
  staffNotes    String?  // resolution notes by manager/staff
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

