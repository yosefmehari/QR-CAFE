# ============================================================
# QR-CAFE Environment Variables
# ============================================================

# 1. PostgreSQL Database URL (Required)
# Connect to your hosted PostgreSQL database (e.g. Neon, Supabase, Railway, AWS RDS, etc.)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# 2. JWT Security Secret (Required in production)
# Generate a secure 32+ character random string: e.g. openssl rand -base64 32
JWT_SECRET="your-super-secure-production-jwt-secret-key-replace-me"

# 3. Next.js Public URL (Optional)
NEXT_PUBLIC_APP_URL="https://your-domain.com"
